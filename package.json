{
  "name": "study-question-bank",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node tests/deployment.cjs",
    "test:db": "node tests/collaboration-db.cjs",
    "test:edge": "node tests/collaboration-edge.cjs",
    "test:collaboration": "node tests/collaboration-all.cjs",
    "test:english": "node tests/english.cjs",
    "test:batch": "node --experimental-vm-modules tests/collaboration-batch.cjs",
    "test:limits": "node tests/collaboration-limits.cjs",
    "test:no-private": "node --experimental-vm-modules tests/no-private.cjs",
    "test:practice": "node --experimental-vm-modules tests/practice.cjs",
    "build": "node scripts/build-static.cjs",
    "check:deploy": "node tests/deployment.cjs",
    "preview": "node scripts/preview.cjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "test:site": "node tests/site-compatibility.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "playwright": "1.62.1",
    "wrangler": "4.168.0"
  }
}
