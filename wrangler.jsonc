{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "algorithm-question-bank",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
